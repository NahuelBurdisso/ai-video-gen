{
  "1": {
    "class_type": "CLIPLoaderGGUF",
    "inputs": {"clip_name": "umt5-xxl-Q4.gguf", "type": "wan"}
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "{{prompt}}", "clip": ["1", 0]}
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "{{negative_prompt}}", "clip": ["1", 0]}
  },
  "4": {
    "class_type": "WanVideoModelLoader",
    "inputs": {"model": "wan2.2-i2v-14B-Q4_K_M.gguf", "base_precision": "bf16", "quantization": "disabled", "load_device": "offload_device"}
  },
  "5": {
    "class_type": "WanVideoVAELoader",
    "inputs": {"model_name": "wan2.2-vae.safetensors", "precision": "bf16"}
  },
  "11": {
    "class_type": "LoadImage",
    "inputs": {"image": "{{input_image}}"}
  },
  "12": {
    "class_type": "CLIPVisionLoader",
    "inputs": {"clip_name": "clip-vit-large-patch14.safetensors"}
  },
  "13": {
    "class_type": "WanVideoClipVisionEncode",
    "inputs": {
      "clip_vision": ["12", 0],
      "image_1": ["11", 0],
      "strength_1": 1.0,
      "strength_2": 1.0,
      "crop": "center",
      "combine_embeds": "average",
      "force_offload": true
    }
  },
  "6": {
    "class_type": "WanVideoImageToVideoEncode",
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "num_frames": "{{num_frames}}",
      "noise_aug_strength": 0.0,
      "start_latent_strength": 1.0,
      "end_latent_strength": 1.0,
      "force_offload": true,
      "vae": ["5", 0],
      "clip_embeds": ["13", 0],
      "start_image": ["11", 0]
    }
  },
  "7": {
    "class_type": "WanVideoTextEmbedBridge",
    "inputs": {"positive": ["2", 0], "negative": ["3", 0]}
  },
  "8": {
    "class_type": "WanVideoSampler",
    "inputs": {
      "model": ["4", 0],
      "image_embeds": ["6", 0],
      "text_embeds": ["7", 0],
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "shift": "{{shift}}",
      "seed": "{{seed}}",
      "force_offload": true,
      "scheduler": "unipc",
      "riflex_freq_index": 0
    }
  },
  "9": {
    "class_type": "WanVideoDecode",
    "inputs": {
      "vae": ["5", 0],
      "samples": ["8", 0],
      "enable_vae_tiling": false,
      "tile_x": 272,
      "tile_y": 272,
      "tile_stride_x": 144,
      "tile_stride_y": 128
    }
  },
  "10": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["9", 0],
      "frame_rate": 16,
      "loop_count": 0,
      "filename_prefix": "{{filename_prefix}}",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}
